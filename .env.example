# ===================================================
# FoodBridge – Environment Configuration Template
# ===================================================

# --- Backend Configuration ---
PORT=5000

# Optional: Supabase Database Credentials
# (If omitted, the platform automatically runs on the built-in local JSON database engine)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Groq AI API Key for Food Rescue Assistant
# Get an API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Development flag for custom local TLS certs (leave unset or false in production)
ALLOW_INSECURE_TLS=false

# --- Frontend Configuration ---
# Optional: API backend URL (defaults to http://localhost:5000)
VITE_API_URL=http://localhost:5000

