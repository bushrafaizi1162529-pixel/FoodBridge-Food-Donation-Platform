# Backend Server Port
PORT=5000

# Allowed Frontend URL for Production CORS (e.g., https://your-foodbridge.vercel.app)
FRONTEND_URL=https://your-app.vercel.app

# Supabase PostgreSQL Configuration (Optional)
# If omitted or offline, FoodBridge seamlessly falls back to local JSON storage
SUPABASE_URL=https://your-project-id.supabase.co
# In production on Render, use the service_role key for secure backend database access
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Groq AI API Key for Server-Side AI Assistant
GROQ_API_KEY=your_groq_api_key_here

# TLS Certificate setting for Node 24+ local dev (false for production)
ALLOW_INSECURE_TLS=false
